GEMINI_API_KEY=
APP_URL="http://localhost:3000"

# POST webhook. FlowShare sends new workflows here; n8n should append/upsert to Google Sheets.
N8N_WORKFLOW_WEBHOOK_URL=http://localhost:5678/webhook/save-workflow

# Optional shared secret. n8n can verify this from the `x-flowshare-secret` header.
N8N_WEBHOOK_SECRET=

# Optional GET webhook. Use this if n8n returns `{ "workflows": [...] }` from Google Sheets.
N8N_LIST_WEBHOOK_URL=http://localhost:5678/webhook/list-workflows

# Optional direct Google Sheet CSV URL. Used when N8N_LIST_WEBHOOK_URL is empty.
# Example: https://docs.google.com/spreadsheets/d/e/{published_id}/pub?output=csv
GOOGLE_SHEETS_CSV_URL=

# n8n File Upload Validator webhook (n8n_file_upload_full_validator).
# Path ใน n8n: POST /webhook/check-file
N8N_VALIDATOR_WEBHOOK_URL=

# n8n AI Description Generator webhook (n8n_generate_description_howto).
# Path ใน n8n: POST /webhook/generate-description
N8N_GENERATOR_WEBHOOK_URL=
