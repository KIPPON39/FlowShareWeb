# ==========================================
# FlowShare Web - Environment Variables Guide
# ==========================================

# ------------------------------------------
# 1. Security & Authentication
# ------------------------------------------
# Secret key used for signing JWT sessions
JWT_SECRET_KEY="super_secret_jwt_key_change_me_in_production"

# Superadmin credentials (Bypasses Google Sheets Auth)
# Use this to login to the Admin Panel if your sheets are disconnected.
SUPERADMIN_EMAIL="superadmin@example.com"
SUPERADMIN_PASSWORD="super_secret_password"

# ------------------------------------------
# 2. n8n Webhook Endpoints
# ------------------------------------------
# Authentication header required by your n8n webhooks
N8N_WEBHOOK_SECRET="your_secure_webhook_secret_key"

# User Management & Auth
N8N_WEBHOOK_LOGIN_URL="https://your-n8n-instance.com/webhook/login"

# Workflow Management
N8N_LIST_WEBHOOK_URL="https://your-n8n-instance.com/webhook/list-workflows"
N8N_WORKFLOW_WEBHOOK_URL="https://your-n8n-instance.com/webhook/upsert-workflow"
N8N_VIEW_WEBHOOK_URL="https://your-n8n-instance.com/webhook/view-workflow"
N8N_VALIDATOR_WEBHOOK_URL="https://your-n8n-instance.com/webhook/check-file"
N8N_GENERATOR_WEBHOOK_URL="https://your-n8n-instance.com/webhook/generate-description"

# Requests (Speaker & Download)
N8N_SPEAKER_REQUEST_URL="https://your-n8n-instance.com/webhook/speaker-request"
N8N_SPEAKER_CHECKSTATUS_URL="https://your-n8n-instance.com/webhook/speaker-status"
N8N_SPEAKER_RESPONSE_URL="https://your-n8n-instance.com/webhook/speaker-response"
N8N_DOWNLOAD_REQUEST_URL="https://your-n8n-instance.com/webhook/download-request"

# Admin panel settings
N8N_SOCIAL_LINKS_WEBHOOK_URL="https://your-n8n-instance.com/webhook/social-links"

# ------------------------------------------
# 3. Default Google Sheet IDs
# ------------------------------------------
# (These can also be overridden dynamically via the Admin Panel UI)
GOOGLE_SHEET_ID_USERS="your_users_sheet_id_here"
GOOGLE_SHEET_ID_FLOWS="your_flows_sheet_id_here"
GOOGLE_SHEET_ID_DOWNLOAD_REQUESTS="your_download_requests_sheet_id_here"
GOOGLE_SHEET_ID_SPEAKER_REQUESTS="your_speaker_requests_sheet_id_here"
GOOGLE_SHEET_ID_SOCIAL_LINKS="your_social_links_sheet_id_here"

# ------------------------------------------
# 4. Google Service Account (Fallback logic)
# ------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# Note: When pasting the private key, ensure \n is preserved correctly.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\n-----END PRIVATE KEY-----\n"

# ------------------------------------------
# 5. AI & External APIs
# ------------------------------------------
# Used for auto-extracting metadata from JSON workflows
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------
# 6. Development Flags
# ------------------------------------------
# Set to 'true' to use sample local JSON data instead of fetching from n8n
ENABLE_MOCK_WORKFLOWS="false"
