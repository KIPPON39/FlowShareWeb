    {
      "parameters": {
        "jsCode": "const thaiNumerals = ['๐', '๑', '๒', '๓', '๔', '๕', '๖', '๗', '๘', '๙'];\nconst thaiMonths = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];\n\nfunction convertToThaiNumerals(text) {\n  if (text === null || text === undefined) return text;\n  return String(text).replace(/[0-9]/g, function(match) {\n    return thaiNumerals[parseInt(match)];\n  });\n}\n\nfunction formatThaiDate(dateString) {\n  if (!dateString || typeof dateString !== 'string' || !dateString.includes('-')) return dateString;\n  const parts = dateString.split('-');\n  if (parts.length === 3) {\n    const year = parseInt(parts[0]) + 543;\n    const month = parseInt(parts[1]) - 1;\n    const day = parseInt(parts[2]);\n    return `${day} ${thaiMonths[month]} ${year}`;\n  }\n  return dateString;\n}\n\nfor (let item of $input.all()) {\n  if (item.json && item.json.body) {\n    const body = item.json.body;\n    \n    const dateFields = ['date', 'event_date', 'lecture_date'];\n    for (const field of dateFields) {\n      if (body[field]) {\n        body[field] = formatThaiDate(body[field]);\n      }\n    }\n    \n    for (const key of Object.keys(body)) {\n      if (typeof body[key] === 'string') {\n        if (!['skrequestID', 'flowID', 'requesterEmail', 'recipientEmail', 'fileName'].includes(key)) {\n          body[key] = convertToThaiNumerals(body[key]);\n        }\n      }\n    }\n  }\n}\n\nreturn $input.all();"
      },
      "id": "078482f4-e728-4f04-828d-9a0f33292850",
      "name": "Convert to Thai Numerals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        4960
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Convert to Thai Numerals').item.json.body.recipientEmail }}",
        "subject": "=ขอเรียนเชิญเป็นวิทยากรบรรยาย - {{ $('Convert to Thai Numerals').item.json.body.event_name }}",
        "message": "=<div style=\"font-family: 'Sarabun', Tahoma, sans-serif; max-width: 700px; margin: 0 auto; background: #ffffff; border: 1px solid #d1d5db; border-top: 4px solid #1e3a8a; border-radius: 4px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);\">  <div style=\"padding: 40px 48px;\">    <p style=\"font-size: 16px; color: #374151; margin: 0 0 8px 0; text-align: right;\">วันที่ {{ $('Convert to Thai Numerals').item.json.body.date }}</p>    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 24px;\">      <tr>        <td style=\"width: 60px; font-weight: bold; color: #111827; padding: 4px 0; vertical-align: top;\">เรื่อง</td>        <td style=\"color: #111827; padding: 4px 0; vertical-align: top;\">ขอเรียนเชิญเป็นวิทยากร</td>      </tr>      <tr>        <td style=\"width: 60px; font-weight: bold; color: #111827; padding: 4px 0; vertical-align: top;\">เรียน</td>        <td style=\"color: #111827; padding: 4px 0; vertical-align: top;\">{{ $('Convert to Thai Numerals').item.json.body.speaker_name }}</td>      </tr>    </table>    <p style=\"font-size: 16px; color: #374151; line-height: 1.8; margin: 0 0 16px; text-indent: 2.5em; text-align: justify;\">      ด้วย {{ $('Convert to Thai Numerals').item.json.body.requesterName }} มีกำหนดจัดโครงการ/กิจกรรม       <strong>&quot;{{ $('Convert to Thai Numerals').item.json.body.event_name }}&quot;</strong>      ในวันที่ {{ $('Convert to Thai Numerals').item.json.body.event_date }}      ณ {{ $('Convert to Thai Numerals').item.json.body.event_location }} โดยมีวัตถุประสงค์เพื่อ {{ $('Convert to Thai Numerals').item.json.body.event_purpose }}    </p>    <p style=\"font-size: 16px; color: #374151; line-height: 1.8; margin: 0 0 24px; text-indent: 2.5em; text-align: justify;\">      ในการนี้ คณะผู้จัดงานพิจารณาแล้วเห็นว่าท่านเป็นผู้มีความรู้ ความสามารถ และประสบการณ์อันเป็นประโยชน์อย่างยิ่ง      จึงใคร่ขอเรียนเชิญท่านเป็นวิทยากรบรรยายในหัวข้อ      <strong>&quot;{{ $('Convert to Thai Numerals').item.json.body.topic }}&quot;</strong>      ในวันที่ {{ $('Convert to Thai Numerals').item.json.body.lecture_date }} เวลา {{ $('Convert to Thai Numerals').item.json.body.time_range }}    </p>    <div style=\"background: #f9fafb; border-left: 4px solid #1e3a8a; padding: 16px 20px; margin-bottom: 32px;\">      <p style=\"font-size: 15px; font-weight: bold; color: #111827; margin: 0 0 12px 0;\">สรุปรายละเอียดการบรรยาย:</p>      <table style=\"width: 100%; border-collapse: collapse; font-size: 15px;\">        <tr>          <td style=\"padding: 6px 0; color: #4b5563; width: 140px;\">หัวข้อบรรยาย:</td>          <td style=\"padding: 6px 0; color: #111827; font-weight: 500;\">{{ $('Convert to Thai Numerals').item.json.body.topic }}</td>        </tr>        <tr>          <td style=\"padding: 6px 0; color: #4b5563;\">วันที่และเวลา:</td>          <td style=\"padding: 6px 0; color: #111827; font-weight: 500;\">{{ $('Convert to Thai Numerals').item.json.body.lecture_date }} เวลา {{ $('Convert to Thai Numerals').item.json.body.time_range }}</td>        </tr>        <tr>          <td style=\"padding: 6px 0; color: #4b5563;\">สถานที่/รูปแบบ:</td>          <td style=\"padding: 6px 0; color: #111827; font-weight: 500;\">{{ $('Convert to Thai Numerals').item.json.body.event_location }}</td>        </tr>      </table>    </div>    <p style=\"font-size: 16px; color: #374151; line-height: 1.8; margin: 0 0 32px; text-indent: 2.5em; text-align: justify;\">      จึงเรียนมาเพื่อโปรดพิจารณาให้ความอนุเคราะห์เป็นวิทยากรตามวัน เวลา และสถานที่ดังกล่าว และขอขอบพระคุณล่วงหน้ามา ณ โอกาสนี้      กรุณาแจ้งผลการพิจารณาการเข้าร่วมผ่านระบบสารสนเทศโดยคลิกที่ปุ่มด้านล่าง    </p>    <div style=\"text-align: center; margin-bottom: 40px;\">      <a href=\"http://localhost:3000/workflow/respond/{{ $('Convert to Thai Numerals').item.json.body.skrequestID }}\" style=\"display: inline-block; background-color: #1e3a8a; color: #ffffff; font-size: 16px; font-weight: bold; padding: 14px 36px; border-radius: 4px; text-decoration: none; border: 1px solid #1e3a8a;\">        แจ้งผลการพิจารณา &rarr;      </a>      <p style=\"font-size: 13px; color: #6b7280; margin: 12px 0 0;\">(คลิกเพื่อพิจารณาตอบรับหรือปฏิเสธคำเชิญในระบบ)</p>    </div>    <div style=\"text-align: right; margin-top: 40px;\">      <p style=\"font-size: 16px; color: #374151; margin: 0 0 32px 0;\">ขอแสดงความนับถือ</p>      <p style=\"font-size: 16px; color: #111827; font-weight: bold; margin: 0 0 4px 0;\">( {{ $('Convert to Thai Numerals').item.json.body.signer_name }} )</p>      <p style=\"font-size: 15px; color: #4b5563; margin: 0;\">{{ $('Convert to Thai Numerals').item.json.body.signer_position }}</p>    </div>  </div>  <div style=\"background: #f3f4f6; border-top: 1px solid #e5e7eb; padding: 16px 48px; font-size: 13px; color: #6b7280; line-height: 1.6;\">    <p style=\"margin: 0 0 4px 0;\"><strong>ผู้ประสานงาน:</strong> {{ $('Convert to Thai Numerals').item.json.body.requesterName }}</p>    <p style=\"margin: 0 0 4px 0;\"><strong>อีเมลติดต่อ:</strong> {{ $('Convert to Thai Numerals').item.json.body.requesterEmail }}</p>    <p style=\"margin: 12px 0 0; text-align: center; font-size: 12px; color: #9ca3af;\">เอกสารฉบับนี้จัดทำและนำส่งโดยอัตโนมัติผ่านระบบสารสนเทศ FlowShare</p>  </div></div>",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {}
            ]
          }
        }
