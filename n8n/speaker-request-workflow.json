    {
      "parameters": {
        "sendTo": "={{ $('Convert to Thai Numerals').item.json.body.requesterEmail }}",
        "subject": "=สำเนาหนังสือเรียนเชิญวิทยากร - {{ $('Convert to Thai Numerals').item.json.body.event_name }}",
        "message": "=<div style=\"font-family: 'Sarabun', Tahoma, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff; border: 1px solid #d1d5db; border-top: 4px solid #1e3a8a; border-radius: 4px; overflow: hidden;\">  <div style=\"padding: 32px 40px;\">    <p style=\"font-size: 18px; font-weight: bold; color: #1e3a8a; margin: 0 0 24px 0; text-align: center;\">สำเนาหนังสือเรียนเชิญวิทยากร (จัดส่งเรียบร้อยแล้ว)</p>    <p style=\"font-size: 16px; color: #374151; margin: 0 0 16px 0;\"><strong>เรียน:</strong> {{ $('Convert to Thai Numerals').item.json.body.requesterName }}</p>    <p style=\"font-size: 16px; color: #374151; line-height: 1.8; margin: 0 0 24px 0;\">      ระบบได้ดำเนินการจัดส่งหนังสือเรียนเชิญวิทยากรถึง <strong>{{ $('Convert to Thai Numerals').item.json.body.speaker_name }}</strong> เป็นที่เรียบร้อยแล้ว ตามรายละเอียดหัวข้อ &quot;{{ $('Convert to Thai Numerals').item.json.body.topic }}&quot;    </p>    <div style=\"background: #f9fafb; border-left: 4px solid #10b981; padding: 16px; margin-bottom: 24px;\">      <p style=\"font-size: 15px; color: #4b5563; margin: 0;\">        ท่านสามารถดาวน์โหลดสำเนาเอกสารหนังสือเชิญ (รูปแบบ PDF และ Word) ได้จากไฟล์แนบในอีเมลฉบับนี้ เพื่อเก็บไว้เป็นหลักฐานการดำเนินงาน      </p>    </div>    <p style=\"font-size: 16px; color: #374151; line-height: 1.8; margin: 0 0 32px 0;\">      และสามารถติดต่อวิทยากรได้ที่อีเมล: <a href=\"mailto:{{ $('Convert to Thai Numerals').item.json.body.recipientEmail }}\" style=\"color: #2563eb; text-decoration: none;\">{{ $('Convert to Thai Numerals').item.json.body.recipientEmail }}</a>    </p>    <p style=\"font-size: 16px; color: #374151; margin: 0;\">จึงเรียนมาเพื่อโปรดทราบ</p>  </div>  <div style=\"background: #f3f4f6; border-top: 1px solid #e5e7eb; padding: 16px 40px; font-size: 12px; color: #6b7280; text-align: center;\">    ระบบสร้างเอกสารอัตโนมัติ FlowShare — ห้ามตอบกลับอีเมลนี้  </div></div>",
