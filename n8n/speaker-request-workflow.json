    {
      "parameters": {
        "jsCode": "const thaiNumerals = ['๐', '๑', '๒', '๓', '๔', '๕', '๖', '๗', '๘', '๙'];\nconst thaiMonths = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];\n\nfunction convertToThaiNumerals(text) {\n  if (text === null || text === undefined) return text;\n  return String(text).replace(/[0-9]/g, function(match) {\n    return thaiNumerals[parseInt(match)];\n  });\n}\n\nfunction formatThaiDate(dateString) {\n  if (!dateString || typeof dateString !== 'string' || !dateString.includes('-')) return dateString;\n  const parts = dateString.split('-');\n  if (parts.length === 3) {\n    const year = parseInt(parts[0]) + 543;\n    const month = parseInt(parts[1]) - 1;\n    const day = parseInt(parts[2]);\n    return `${day} ${thaiMonths[month]} ${year}`;\n  }\n  return dateString;\n}\n\nfor (let item of $input.all()) {\n  if (item.json && item.json.body) {\n    const body = item.json.body;\n    \n    const dateFields = ['date', 'event_date', 'lecture_date'];\n    for (const field of dateFields) {\n      if (body[field]) {\n        body[field] = formatThaiDate(body[field]);\n      }\n    }\n    \n    for (const key of Object.keys(body)) {\n      if (typeof body[key] === 'string') {\n        if (!['skrequestID', 'flowID', 'requesterEmail', 'recipientEmail', 'fileName'].includes(key)) {\n          body[key] = convertToThaiNumerals(body[key]);\n        }\n      }\n    }\n  }\n}\n\nreturn $input.all();"
      },
      "id": "cff28b44-268d-4972-8e46-80633eb746b8",
      "name": "Convert to Thai Numerals",
      "type": "n8n-nodes-base.code",
