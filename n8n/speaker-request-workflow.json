    {
      "parameters": {
        "jsCode": "const thaiNumerals = ['๐', '๑', '๒', '๓', '๔', '๕', '๖', '๗', '๘', '๙'];\nconst thaiMonths = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];\n\nfunction convertToThaiNumerals(text) {\n  if (text === null || text === undefined) return text;\n  return String(text).replace(/[0-9]/g, function(match) {\n    return thaiNumerals[parseInt(match)];\n  });\n}\n\nfunction formatThaiDate(dateString) {\n  if (!dateString || typeof dateString !== 'string' || !dateString.includes('-')) return dateString;\n  const parts = dateString.split('-');\n  if (parts.length === 3) {\n    const year = parseInt(parts[0]) + 543;\n    const month = parseInt(parts[1]) - 1;\n    const day = parseInt(parts[2]);\n    return `${day} ${thaiMonths[month]} ${year}`;\n  }\n  return dateString;\n}\n\nfor (let item of $input.all()) {\n  if (item.json && item.json.body) {\n    const body = item.json.body;\n    \n    const dateFields = ['date', 'event_date', 'lecture_date'];\n    for (const field of dateFields) {\n      if (body[field]) {\n        body[field] = formatThaiDate(body[field]);\n      }\n    }\n    \n    for (const key of Object.keys(body)) {\n      if (typeof body[key] === 'string') {\n        if (!['skrequestID', 'flowID', 'requesterEmail', 'recipientEmail', 'fileName'].includes(key)) {\n          body[key] = convertToThaiNumerals(body[key]);\n        }\n      }\n    }\n  }\n}\n\nreturn $input.all();"
      },
      "id": "960fe93a-2028-4e62-9860-84bc4838de0b",
      "name": "Convert to Thai Numerals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2784,
        1824
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Convert to Thai Numerals').first().json.body.recipientEmail }}",
        "subject": "=ขอเรียนเชิญเป็นวิทยากรบรรยาย - {{ $('Convert to Thai Numerals').first().json.body.event_name }}",
        "message": "=เรื่อง: ขอความอนุเคราะห์บุคลากรเป็นวิทยากร\nเรียน: {{ $('Convert to Thai Numerals').first().json.body.speaker_name }}\n\n        ด้วย {{ $('Convert to Thai Numerals').first().json.body.requesterName }} มีกำหนดจัดโครงการ/กิจกรรม \"{{ $('Convert to Thai Numerals').first().json.body.event_name }}\" ในวันที่ {{ $('Convert to Thai Numerals').first().json.body.event_date }} ณ {{ $('Convert to Thai Numerals').first().json.body.event_location }}\n\n        ในการนี้ คณะผู้จัดงานพิจารณาแล้วเห็นว่าท่านเป็นผู้มีความรู้ ความสามารถ จึงใคร่ขอเรียนเชิญท่านเป็นวิทยากรบรรยายในหัวข้อ \"{{ $('Convert to Thai Numerals').first().json.body.topic }}\" ในวันที่ {{ $('Convert to Thai Numerals').first().json.body.lecture_date }} เวลา {{ $('Convert to Thai Numerals').first().json.body.time_range }} น.\n\n        รายละเอียดเพิ่มเติมสามารถตรวจสอบได้จากเอกสารหนังสือเชิญที่แนบมาพร้อมกับอีเมลฉบับนี้\n\n        จึงเรียนมาเพื่อโปรดพิจารณาให้ความอนุเคราะห์ และขอขอบพระคุณล่วงหน้ามา ณ โอกาสนี้\n\nขอแสดงความนับถือ\n\n( {{ $('Convert to Thai Numerals').first().json.body.signer_name }} )\n{{ $('Convert to Thai Numerals').first().json.body.signer_position }}",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data"
              }
            ]
          }
        }
      },
