    {
      "parameters": {
        "jsCode": "const thaiData = $('Convert to Thai Numerals').first().json.body;\nconst eventName = thaiData.event_name || 'งาน';\nconst requestId = thaiData.skrequestID || $('Convert to Thai Numerals').first().json.skrequestID || '';\nconst baseName = `หนังสือเชิญวิทยากร_${eventName}_${requestId}`;\n\nfor (let item of $input.all()) {\n  if (item.binary) {\n    if (item.binary.data) {\n      item.binary.data.fileName = baseName + '.pdf';\n      item.binary.data.mimeType = 'application/pdf';\n    }\n    if (item.binary.data2) {\n      item.binary.data2.fileName = baseName + '.docx';\n      item.binary.data2.mimeType = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';\n    }\n  }\n}\nreturn $input.all();"
      },
