{
  "name": "FlowShare Social Links Manager",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "social-links",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "get-webhook",
      "name": "GET Social Links Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "social-links-get"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "social-links",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "post-webhook",
      "name": "POST Save Social Links Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 700],
      "webhookId": "social-links-post"
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.query.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "options": {
          "range": "A:B"
        }
      },
      "id": "read-sheet",
      "name": "Read Social Links",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [520, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// แปลง rows จาก Google Sheets เป็น JSON array\nconst items = $input.all();\nconst links = items\n  .filter(item => item.json.platform && item.json.platform.trim() !== '')\n  .map(item => ({\n    platform: (item.json.platform || '').toString().trim(),\n    url: (item.json.url || '').toString().trim()\n  }));\n\nreturn [{ json: { links } }];"
      },
      "id": "format-get-response",
      "name": "Format GET Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "respond-get",
      "name": "Respond GET",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "jsCode": "// รับ links array จาก POST body แล้วแปลงเป็นแถวสำหรับ Google Sheets\nconst body = $input.first().json.body;\nconst links = body.links || [];\nconst sheetId = body.sheetId || '';\n\nif (!sheetId) {\n  throw new Error('Missing sheetId in request body');\n}\n\nif (!Array.isArray(links)) {\n  throw new Error('Invalid links format - expected array');\n}\n\n// สร้าง rows สำหรับเขียนลง Google Sheets\nconst rows = links.map(link => ({\n  platform: link.platform || '',\n  url: link.url || ''\n}));\n\nreturn [{ json: { sheetId, rows, linkCount: rows.length } }];"
      },
      "id": "prepare-save-data",
      "name": "Prepare Save Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 700]
    },
    {
      "parameters": {
        "operation": "clear",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "clear": "wholeSheet",
        "options": {}
      },
      "id": "clear-sheet",
      "name": "Clear Existing Data",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [740, 700],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ดึง rows กลับมาจาก input เดิม (ก่อน clear)\nconst originalData = $('Prepare Save Data').first().json;\nconst rows = originalData.rows;\nconst sheetId = originalData.sheetId;\n\n// สร้าง items แต่ละแถวสำหรับ Google Sheets append\nconst items = rows.map(row => ({\n  json: {\n    platform: row.platform,\n    url: row.url,\n    _sheetId: sheetId\n  }\n}));\n\n// ถ้าไม่มี row ให้ return ว่าง\nif (items.length === 0) {\n  return [{ json: { platform: '', url: '', _sheetId: sheetId } }];\n}\n\nreturn items;"
      },
      "id": "split-rows",
      "name": "Split Rows for Append",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 700]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json._sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "platform": "={{ $json.platform }}",
            "url": "={{ $json.url }}"
          }
        },
        "options": {}
      },
      "id": "write-sheet",
      "name": "Write Social Links",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1180, 700],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Social links saved successfully', count: $('Prepare Save Data').first().json.linkCount }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "respond-post",
      "name": "Respond POST Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1400, 700]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ links: [] }) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "respond-get-empty",
      "name": "Respond Empty",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [740, 140]
    },
    {
